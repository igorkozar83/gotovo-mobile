    "globalSetup": "./testUtils/timezone.js",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "collectCoverageFrom": [
      "App.js",
      "RootNavigation.js",
      "{components,screens,hooks,Helpers,Services,stores,styles,data}/**/*.js",
      "!**/__tests__/**",
      "!**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "statements": 88,
        "branches": 78,
        "functions": 83
      }
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "{App.js,components/**/*.js,screens/**/*.js,hooks/**/*.js,Helpers/**/*.js,Services/**/*.js,stores/**/*.js,testUtils/**/*.js}": "jest --bail --findRelatedTests --passWithNoTests"
